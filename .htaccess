# Sicherheitsnetz für den Fall, dass die Repo-Wurzel als Docroot ausgeliefert wird.
#
# Das eigentliche Docroot ist public/. Solange der Webserver noch auf dieses
# Verzeichnis zeigt (etwa während der Umstellung beim Hoster), wird hier jede
# Anfrage intern nach public/ umgeleitet – auch Anfragen auf existierende Dateien
# wie /database.sql, die dann in public/ nicht gefunden werden (404).
#
# Steht das Docroot auf public/, wertet Apache diese Datei nicht aus.

RewriteEngine On

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
