RewriteEngine On

# Dieses Verzeichnis (public/) ist das Docroot. Alles außerhalb – api/src, api/config,
# api/vendor, database.sql, Doku – ist vom Webserver aus nicht erreichbar.

# ── API ───────────────────────────────────────────────────────────────────────
# Route alle /api/* Anfragen an den PHP Front-Controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Sitemap wird von der API erzeugt
RewriteRule ^sitemap\.xml$ api/index.php [QSA,L]

# ── Frontend-Routen ───────────────────────────────────────────────────────────
# /map/{username} → app/index.html (Username wird von app.js aus der URL gelesen)
RewriteRule ^map/[^/]+/?$ app/index.html [L]

# /stats/{username} → app/stats.html
RewriteRule ^stats/[^/]+/?$ app/stats.html [L]

# Root → app/index.html
RewriteRule ^$ app/index.html [L]

# ── MIME-Typen ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────────
# Ohne Cache-Control schätzen Browser die Frische selbst (ca. 10 % der Zeit seit der
# letzten Änderung) – nach einem Deploy liefen Smartphones dann tagelang mit alten
# Skripten. Deshalb ausdrücklich:
# - HTML/JS/CSS/JSON/GeoJSON/Manifest: immer beim Server nachfragen (no-cache). Ist die
#   Datei unverändert, antwortet Apache per ETag nur mit 304 – das kostet kaum etwas.
# - Icons/Bilder: einen Tag.
# - app/vendor/: ein Jahr, immutable – die Version steht im Pfad, eine neue Version hat
#   eine neue URL. Als <If>, weil Apache <If> nach <FilesMatch> auswertet; eine eigene
#   .htaccess in vendor/ würde von den FilesMatch-Regeln oben überschrieben.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|json|geojson|webmanifest|xml|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(ico|png|svg)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#/app/vendor/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

# ── Security-Header ───────────────────────────────────────────────────────────
# Die vollständige Content-Security-Policy steht als <meta>-Tag in den HTML-Dateien;
# frame-ancestors wirkt nur als HTTP-Header und steht deshalb hier.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # Zunächst kurze Laufzeit; nach erfolgreichem Test auf 31536000 erhöhen (siehe README).
    # Ohne env=HTTPS: Hinter dem Reverse-Proxy des Hosters ist die Variable unzuverlässig,
    # und Browser ignorieren den Header bei HTTP-Antworten ohnehin.
    Header always set Strict-Transport-Security "max-age=300"
</IfModule>
